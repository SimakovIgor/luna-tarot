# Luna Tarot — production reverse proxy.
#
# ACME (Let's Encrypt) идёт через DNS-01 challenge с DuckDNS API token —
# это надёжнее, чем HTTP/TLS-ALPN, особенно для DuckDNS сабдоменов:
# их secondary nameservers иногда возвращают SERVFAIL и Let's Encrypt
# не может валидировать домен. DNS-01 обходит эту проблему: Caddy
# напрямую дёргает DuckDNS API через токен.
#
# DUCKDNS_TOKEN должен быть в .env.

# Uptime Kuma — отдельный поддомен с auto-HTTPS.
# DNS-01 с явными публичными resolvers (внутренний Docker DNS таймаутит
# при propagation check к authoritative nameservers DuckDNS).
{$LUNA_KUMA_DOMAIN} {
    tls {
        dns duckdns {$DUCKDNS_TOKEN}
        resolvers 1.1.1.1 8.8.8.8
        propagation_delay 30s
        propagation_timeout 5m
    }
    reverse_proxy kuma:3001
    encode gzip zstd
    log {
        output stdout
        format console
    }
}

{$LUNA_DOMAIN} {
    tls {
        dns duckdns {$DUCKDNS_TOKEN}
        resolvers 1.1.1.1 8.8.8.8
        propagation_delay 30s
        propagation_timeout 5m
    }
    # Mini App + REST + actuator → backend (Spring Boot слушает 8080 внутри сети)
    handle /app/* {
        reverse_proxy backend:8080
    }
    handle /api/* {
        reverse_proxy backend:8080
    }
    handle /actuator/* {
        reverse_proxy backend:8080
    }
    # Admin-панель (опционально, защищена HTTP Basic в самом backend'е)
    handle /admin/* {
        reverse_proxy backend:8080
    }

    # Корень и всё прочее → landing (nginx со статикой)
    handle {
        reverse_proxy landing:80
    }

    # Сжатие — экономит трафик
    encode gzip zstd

    # Логи в stdout — видно через `docker logs luna-caddy`
    log {
        output stdout
        format console
    }
}
